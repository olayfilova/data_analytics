DROP TABLE IF EXISTS unesco_raw CASCADE;
DROP TABLE IF EXISTS unesco CASCADE;
DROP TABLE IF EXISTS category CASCADE;
DROP TABLE IF EXISTS state CASCADE;
DROP TABLE IF EXISTS region CASCADE;
DROP TABLE IF EXISTS iso CASCADE;

-- Create lookup tables
CREATE TABLE category (
    id SERIAL PRIMARY KEY,
    name VARCHAR(128) UNIQUE
);

CREATE TABLE state (
    id SERIAL PRIMARY KEY,
    name VARCHAR(128) UNIQUE
);

CREATE TABLE region (
    id SERIAL PRIMARY KEY,
    name VARCHAR(128) UNIQUE
);

CREATE TABLE iso (
    id SERIAL PRIMARY KEY,
    name VARCHAR(128) UNIQUE
);

-- Create raw data table
CREATE TABLE unesco_raw (
    name TEXT, description TEXT, justification TEXT, year INTEGER,
    longitude FLOAT, latitude FLOAT, area_hectares FLOAT,
    category TEXT, state TEXT, region TEXT, iso TEXT
);

-- Load data from CSV into unesco_raw
\copy unesco_raw(name,description,justification,year,longitude,latitude,area_hectares,category,state,region,iso) FROM 'whc-sites-2018-small.csv' WITH DELIMITER ',' CSV HEADER;

-- Insert distinct values into lookup tables
INSERT INTO category (name) SELECT DISTINCT category FROM unesco_raw WHERE category IS NOT NULL ON CONFLICT DO NOTHING;
INSERT INTO state (name) SELECT DISTINCT state FROM unesco_raw WHERE state IS NOT NULL ON CONFLICT DO NOTHING;
INSERT INTO region (name) SELECT DISTINCT region FROM unesco_raw WHERE region IS NOT NULL ON CONFLICT DO NOTHING;
INSERT INTO iso (name) SELECT DISTINCT iso FROM unesco_raw WHERE iso IS NOT NULL ON CONFLICT DO NOTHING;

-- Create normalized unesco table
CREATE TABLE unesco (
    id SERIAL PRIMARY KEY,
    name TEXT,
    description TEXT,
    justification TEXT,
    year INTEGER,
    longitude FLOAT,
    latitude FLOAT,
    area_hectares FLOAT,
    category_id INTEGER REFERENCES category(id) ON DELETE CASCADE,
    state_id INTEGER REFERENCES state(id) ON DELETE CASCADE,
    region_id INTEGER REFERENCES region(id) ON DELETE CASCADE,
    iso_id INTEGER REFERENCES iso(id) ON DELETE CASCADE
);

-- Populate unesco table with foreign keys
INSERT INTO unesco (name, description, justification, year, longitude, latitude, area_hectares, category_id, state_id, region_id, iso_id)
SELECT
    ur.name, ur.description, ur.justification, ur.year, ur.longitude, ur.latitude, ur.area_hectares,
    c.id, s.id, r.id, i.id
FROM unesco_raw ur
LEFT JOIN category c ON ur.category = c.name
LEFT JOIN state s ON ur.state = s.name
LEFT JOIN region r ON ur.region = r.name
LEFT JOIN iso i ON ur.iso = i.name;
